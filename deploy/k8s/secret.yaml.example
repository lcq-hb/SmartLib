# =============================================================================
# SmartLib Secret 模板（示例文件，不要提交真实值）
#
# 用法（二选一，推荐 B）：
#   A. 复制成 secret.yaml 后填值再 apply
#        cp deploy/k8s/secret.yaml.example deploy/k8s/secret.yaml
#        # 编辑填值
#        kubectl apply -f deploy/k8s/secret.yaml
#      （.gitignore 已忽略 deploy/k8s/secret.yaml，避免误提交）
#
#   B. 直接用命令创建，secret.yaml 永不落盘：
#        kubectl -n smartlib create secret generic smartlib-secret \
#          --from-literal=MYSQL_ROOT_PASSWORD="$(openssl rand -base64 24)" \
#          --from-literal=MYSQL_PASSWORD="$(openssl rand -base64 24)" \
#          --from-literal=REDIS_PASSWORD="$(openssl rand -base64 24)" \
#          --from-literal=SMARTLIB_INTERNAL_SIGN="$(openssl rand -hex 32)"
#
# 生产建议：接入 External Secrets Operator / Sealed Secrets / Vault，
#           让集群里的 Secret 由密钥管理系统下发，而不是靠人手工 apply。
#
# stringData 与 data 的区别：stringData 接受明文（写入 etcd 时自动 base64），
# 可读性更好；如果要用 data，值必须是 base64 编码后的字符串。
# 注意：secret.yaml.example 本身入库，因此这里的值全部是占位符，不可直接用于生产。
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: smartlib-secret
  namespace: smartlib
  labels:
    app.kubernetes.io/name: smartlib
    app.kubernetes.io/component: secret
type: Opaque
stringData:
  # ---------------------------- 数据库 --------------------------------------
  # MySQL 容器/StatefulSet 初始化用的 root 口令
  MYSQL_ROOT_PASSWORD: "REPLACE_ME_root_password"
  # 应用账号（对应 03-mysql-production-extras.sql 里创建的 smartlib_app）
  MYSQL_PASSWORD: "REPLACE_ME_app_password"
  # 只读账号（报表 / Agent 只读工具 / DBA 排查）
  MYSQL_RO_PASSWORD: "REPLACE_ME_ro_password"

  # ---------------------------- 缓存 ----------------------------------------
  # Redis 未开 requirepass 时留空字符串；开了必须同时给后端与 Agent 配上
  REDIS_PASSWORD: ""

  # ---------------------------- 内部接口签名 ---------------------------------
  # 后端与 Agent 必须一致：Agent 调 /internal/agent/** 时算 HMAC-SHA256
  # 生成：openssl rand -hex 32
  SMARTLIB_INTERNAL_SIGN: "REPLACE_ME_with_openssl_rand_hex_32"

  # ---------------------------- LLM（可选） ---------------------------------
  # LLM_PROVIDER=mock 时不需要；切 openai_compat 时填真实 Key
  OPENAI_API_KEY: ""
  OPENAI_BASE_URL: "https://api.deepseek.com/v1"
