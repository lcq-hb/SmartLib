# =============================================================================
# SmartLib Agent 服务环境变量示例
# 复制为 .env 即可生效（pydantic-settings 会自动读取同目录 .env）。
# 不改任何一行也能启动：默认 LLM_PROVIDER=mock，零 Key 离线可跑。
# =============================================================================

# ---------------- 服务 ----------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ---------------- Agent 运行时（蓝图 §6.4 的 G1~G5 方案开关）----------------
# rule   : 纯规则直答，不调 LLM（对应 G1 基线 / 应急降级）
# llm    : 纯 LLM 决策 + Function Calling（对应 G2）
# hybrid : 规则路由 + LLM 兜底（对应 G5，默认）
# plan   : Plan-and-Execute 多步编排（对应 G4）
AGENT_MODE=hybrid
MAX_STEPS=5
STEP_TIMEOUT_SECONDS=3.0
LOW_CONFIDENCE_THRESHOLD=0.45
MAX_OUTPUT_CHARS=800
LOOP_REPEAT_LIMIT=2

# ---------------- Java 后端 ----------------
JAVA_BASE_URL=http://127.0.0.1:8080
JAVA_TIMEOUT_SECONDS=3.0
JAVA_RETRIES=2
JAVA_CIRCUIT_FAIL_THRESHOLD=5
JAVA_CIRCUIT_OPEN_SECONDS=10.0
# 必须与 backend application.yml 的 SMARTLIB_INTERNAL_SIGN 完全一致
INTERNAL_SIGN_SECRET=dev-internal-secret-please-change
INTERNAL_SIGN_ENABLED=true

# ---------------- LLM ----------------
# mock = 确定性规则模拟（默认，零 Key）；openai_compat = 真实 OpenAI 兼容服务
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2

# ---------------- RAG ----------------
KNOWLEDGE_DIR=app/knowledge
RAG_TOP_K=4
RAG_BM25_WEIGHT=0.7
RAG_VECTOR_WEIGHT=0.3
RAG_ENABLE_VECTOR=true
RAG_CHUNK_SIZE=320
RAG_CHUNK_OVERLAP=60

# ---------------- Memory ----------------
SESSION_MAX_TURNS=10
SESSION_TTL_SECONDS=1800
PROFILE_TTL_SECONDS=86400
